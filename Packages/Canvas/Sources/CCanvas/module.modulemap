// `import CCanvas`: the C ABI of every Rust-drawn surface (the shared device, the timeline, the
// map and the diff), generated by cbindgen in crates/canvas-ffi (`cargo xtask canvas-header`).
// No `link`: the host links libpultik_ffi.a itself, so a test bundle importing these types
// never pulls in a second copy.
module CCanvas {
    header "../../../../crates/canvas-ffi/include/canvas.h"
    export *
}
