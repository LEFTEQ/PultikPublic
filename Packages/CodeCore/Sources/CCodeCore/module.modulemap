// `import CCodeCore`: the C ABI of code-core-ffi (in libpultik_ffi), generated by cbindgen in the Rust crate
// (`cargo xtask code-core-header`). No `link`: the host links the static library itself, so a
// test bundle importing these types never pulls in a second copy.
module CCodeCore {
    header "../../../../crates/code-core-ffi/include/code_core.h"
    export *
}
