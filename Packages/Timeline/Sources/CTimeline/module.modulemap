// `import CTimeline`: the C ABI of the timeline engine, generated by cbindgen in the Rust crate
// (`cargo xtask timeline-header`). No `link`: the host links libpultik_ffi.a itself, so a test
// bundle importing these types never pulls in a second copy.
module CTimeline {
    header "../../../../crates/timeline-ffi/include/timeline.h"
    export *
}
